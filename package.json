{
  "name": "radio-backend-observer",
  "version": "0.1.3",
  "description": "Safe read-only desktop observer for backend metrics via proxy",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist:mac": "electron-builder --mac   --config electron-builder.yml",
    "dist:win": "electron-builder --win   --config electron-builder.yml",
    "dist:linux": "electron-builder --linux --config electron-builder.yml",
    "dist:all": "electron-builder --mac --win --linux --config electron-builder.yml"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^41.0.4",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  }
}
