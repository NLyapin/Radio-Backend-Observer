# API used by renderer
API_BASE=http://127.0.0.1:13200/api

# Render limits (map performance)
MAX_HANDOVER=1200
MAX_COLLISIONS=1200
MAX_BS=600

# Defaults for data time ranges
DEFAULT_RANGE_START=2025-06-14T08:00:00Z
DEFAULT_RANGE_END=2025-06-14T10:09:07Z

# Reset local app logs on each app start: true|false
RESET_LOGS_ON_START=true

# SSH defaults (read-only observer tunnel)
SSH_HOST=your.server.host
SSH_PORT=22
SSH_USER=your_user
SSH_PASSWORD=your_password
SSH_STRICT_HOST_KEY_CHECKING=false

# Auto-connect SSH tunnels at app startup
AUTO_START_TUNNEL=true

# Data source: true = local pre-generated dataset, false = live SSH/kubectl DB
USE_SYNTHETIC_DB=false
